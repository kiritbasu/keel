{
  "cacheScope": "public",
  "tools": [
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "readOnlyHint": true
      },
      "description": "START HERE in any new conversation about a project. Returns a compact digest: what the project is, the active milestone, urgent and blocked work, recent decisions, every unresolved question, the glossary, what is deployed, and a suggested next action.\n\nCall this before reading files or asking the human what is going on — it is one call and roughly 3–4k tokens. With no `project`, returns a one-line roll-up of every project plus anything at risk.\n\nPass `cwd` when you are in a repository. It scopes the digest to whichever project owns that checkout, and if none does it tells you so directly — rather than returning other projects and leaving you to conclude that yours is missing.\n\nOpen questions and glossary terms are never truncated. A missing open question makes you re-litigate something already settled; a missing glossary term makes you use the wrong word for a domain concept. Everything else degrades and the response reports what it dropped.",
      "inputSchema": {
        "properties": {
          "cwd": {
            "description": "The absolute directory you are working in. Resolves to the project whose checkout contains it, and — when nothing matches — says so plainly instead of leaving you to infer it from a list of other projects. Always pass this when you are working in a repository.",
            "type": "string"
          },
          "depth": {
            "default": "standard",
            "description": "How much to include. `brief` is a few hundred tokens; `full` drops most limits.",
            "enum": [
              "brief",
              "standard",
              "full"
            ],
            "type": "string"
          },
          "project": {
            "description": "Project id, slug or name. Omit for a cross-project roll-up.",
            "type": "string"
          },
          "session_id": {
            "description": "A stable identifier for this conversation, minted once at first use and passed on every call. Keel never invents one: a stateless transport has no session to borrow, so provenance is cooperative. Omitting it still works, but the write is attributed only to 'some Claude session'.",
            "type": "string"
          },
          "since": {
            "description": "Only summarise activity after this instant. Useful when resuming a conversation you already have context for.",
            "format": "date-time",
            "type": "string"
          },
          "surface": {
            "description": "Where this call came from.",
            "enum": [
              "chat",
              "cowork",
              "code",
              "ui",
              "cli"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "keel_context",
      "title": "Orient on a project"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "readOnlyHint": true
      },
      "description": "Hybrid keyword and semantic search across every artifact that carries text, in every project. Use it to answer 'what do we know about X', 'has anyone raised this before', or 'what did customers say about onboarding'.\n\nSearches specs, decisions, questions, feedback and design captions by meaning and by keyword together, and tasks, milestones, terms, environments, artifacts and projects by keyword. Metrics are deliberately excluded — they are numbers, and reaching them is a filter rather than a search.\n\nPrefer a natural question over keywords; the semantic half is what makes 'why is billing slow' find a decision titled 'Aggregate hourly, not per-minute'.",
      "inputSchema": {
        "properties": {
          "limit": {
            "default": 20,
            "maximum": 100,
            "minimum": 1,
            "type": "integer"
          },
          "project": {
            "description": "Restrict to one project.",
            "type": "string"
          },
          "query": {
            "description": "What you are looking for.",
            "type": "string"
          },
          "session_id": {
            "description": "A stable identifier for this conversation, minted once at first use and passed on every call. Keel never invents one: a stateless transport has no session to borrow, so provenance is cooperative. Omitting it still works, but the write is attributed only to 'some Claude session'.",
            "type": "string"
          },
          "since": {
            "format": "date-time",
            "type": "string"
          },
          "surface": {
            "description": "Where this call came from.",
            "enum": [
              "chat",
              "cowork",
              "code",
              "ui",
              "cli"
            ],
            "type": "string"
          },
          "types": {
            "description": "Restrict to these artifact types.",
            "items": {
              "enum": [
                "project",
                "milestone",
                "task",
                "spec",
                "decision",
                "question",
                "term",
                "feedback",
                "design",
                "environment",
                "metric",
                "metric_observation",
                "artifact"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "until": {
            "format": "date-time",
            "type": "string"
          }
        },
        "required": [
          "query"
        ],
        "type": "object"
      },
      "name": "keel_search",
      "title": "Search everything"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "readOnlyHint": true
      },
      "description": "Fetch one or more artifacts by id, optionally with their prose body, their linked neighbours, or a diff between two revisions.\n\nUse `depth` to pull in the graph around something — `keel_get(ids: [spec_id], depth: 2)` answers 'what implements this spec, and what do those things depend on' in one call. Use `version` to read an older revision and `diff_against` to see what changed between two.",
      "inputSchema": {
        "properties": {
          "depth": {
            "default": 0,
            "description": "Also return linked neighbours to this depth. 0 means no traversal; 6 is the usual maximum worth asking for.",
            "maximum": 16,
            "minimum": 0,
            "type": "integer"
          },
          "diff_against": {
            "description": "Also return a unified diff between `version` (or the current revision) and this one.",
            "type": "integer"
          },
          "direction": {
            "default": "both",
            "description": "Which way to walk. Outbound follows edges away from the artifact ('what does this implement'); inbound follows edges into it ('what implements this').",
            "enum": [
              "outbound",
              "inbound",
              "both"
            ],
            "type": "string"
          },
          "ids": {
            "description": "Prefixed ULIDs, e.g. tsk_01H8… The prefix says what the artifact is, so you never need to say.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "include_body": {
            "default": true,
            "description": "Include the prose body for artifacts that have one.",
            "type": "boolean"
          },
          "rels": {
            "description": "Restrict the traversal to these relations.",
            "items": {
              "enum": [
                "implements",
                "blocks",
                "depends_on",
                "supersedes",
                "derived_from",
                "resolves",
                "references",
                "duplicates",
                "informs"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "session_id": {
            "description": "A stable identifier for this conversation, minted once at first use and passed on every call. Keel never invents one: a stateless transport has no session to borrow, so provenance is cooperative. Omitting it still works, but the write is attributed only to 'some Claude session'.",
            "type": "string"
          },
          "surface": {
            "description": "Where this call came from.",
            "enum": [
              "chat",
              "cowork",
              "code",
              "ui",
              "cli"
            ],
            "type": "string"
          },
          "version": {
            "description": "Read this document revision instead of the current one.",
            "type": "integer"
          }
        },
        "required": [
          "ids"
        ],
        "type": "object"
      },
      "name": "keel_get",
      "title": "Fetch by id"
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": true,
        "readOnlyHint": true
      },
      "description": "List projects, or resolve a name to one. **Call this before creating a project, every time.** It fuzzy-matches on name, slug, aliases and repository URL, and when anything plausible matches it returns `requires_confirmation: true` with the candidates.\n\nWhen that happens, ask the human before creating anything. Nine near-duplicate projects is the failure mode that quietly ruins the cross-project view, and it is much cheaper to ask than to merge later.",
      "inputSchema": {
        "properties": {
          "include_archived": {
            "default": false,
            "type": "boolean"
          },
          "query": {
            "description": "A name, slug, alias or repo URL to match against. Omit to list everything.",
            "type": "string"
          },
          "session_id": {
            "description": "A stable identifier for this conversation, minted once at first use and passed on every call. Keel never invents one: a stateless transport has no session to borrow, so provenance is cooperative. Omitting it still works, but the write is attributed only to 'some Claude session'.",
            "type": "string"
          },
          "surface": {
            "description": "Where this call came from.",
            "enum": [
              "chat",
              "cowork",
              "code",
              "ui",
              "cli"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "name": "keel_projects",
      "title": "List and resolve projects"
    },
    {
      "annotations": {
